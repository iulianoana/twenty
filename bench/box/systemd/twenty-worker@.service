[Unit]
Description=Twenty bench worker (%i)
After=network.target postgresql.service twenty-redis@%i.service
Requires=twenty-redis@%i.service

[Service]
User=twenty
EnvironmentFile=/opt/twenty-bench/secrets/env/%i.env
WorkingDirectory=/opt/twenty-bench/envs/%i/src/packages/twenty-server
ExecStart=/opt/twenty-bench/node/bin/node dist/queue-worker/queue-worker
Restart=on-failure
RestartSec=3
MemoryMax=2G

[Install]
WantedBy=multi-user.target
